		"rehype-highlight": "^7.0.2",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"satori": "^0.63.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"zod": "^4.6.7"
	}
