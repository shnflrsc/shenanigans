# Database (Supabase local stack: postgresql://postgres:postgres@127.0.0.1:54322/postgres)
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Supabase (local stack prints these with `bunx supabase status`)
PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
PUBLIC_SUPABASE_ANON_KEY="replace-me"
SUPABASE_SERVICE_ROLE_KEY="replace-me"

# Numeric GitHub id of the only allowed admin (gh api user --jq .id)
ADMIN_GITHUB_ID="0"

# Any random string of 16+ characters (openssl rand -hex 32)
RATE_LIMIT_SECRET="replace-with-a-long-random-string"
